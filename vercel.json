{
  "version": 2,
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/browser/data/locations.json"
    }
  },
  "rewrites": [
    {
      "source": "/data/locations.json",
      "destination": "/browser/data/locations.json"
    },
    {
      "source": "/(.*\\.(?:js|mjs|css|map|json|png|jpg|jpeg|gif|webp|avif|svg|ico|woff|woff2|ttf|otf|webmanifest))",
      "destination": "/browser/$1"
    },
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
