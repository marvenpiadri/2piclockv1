{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "2piclock",
  "main": "./dist/server/server.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/browser",
    "run_worker_first": [
      "/api/*",
      "/sitemap*",
      "/robots.txt"
    ]
  },
  "observability": {
    "enabled": true
  }
}
